/* White Label i18n loader — robust DOM-ready language switching */
(function () {
  const supported = ["hu", "en", "es"];

  const safeStorage = {
    get(key) {
      try { return window.localStorage.getItem(key); } catch (_) { return null; }
    },
    set(key, value) {
      try { window.localStorage.setItem(key, value); } catch (_) {}
    }
  };

  const saved = safeStorage.get("wl-language");
  const browser = (navigator.language || "hu").slice(0, 2).toLowerCase();
  const lang = supported.includes(saved)
    ? saved
    : (supported.includes(browser) ? browser : "hu");

  window.WHITE_LABEL_LANGUAGE = lang;

  // Built-in fallback for the sales/footer area. This keeps the important
  // MesterWeb CTA and credits visible even if a host/cache blocks a lang file.
  const footerFallback = {
    hu: {mweb_eye:"NINCS MÉG WEBOLDALA?",mweb_title:"Modern weboldalt szeretne kutyakozmetikájának?",mweb_text:"Ez a Mancs & Móka oldal egy bemutató példa. Hasonló, saját névre, szolgáltatásokra, árakra, képekre és elérhetőségekre szabott oldalt készítünk kutyakozmetikáknak és más kisvállalkozásoknak.",mweb_cta:"Érdeklődöm a weboldalról →",footer_text:"Szép szőr, boldog kutya, nyugodt gazdi.",page:"Oldal",contact:"Kapcsolat",free_gallery_title:"INGYENES KÉPGALÉRIA",free_gallery_text:"A sablonhoz mellékelt, szabadon cserélhető mintaképek.",sources:"Képforrások és fotósok megtekintése →",madeby:"Weboldal készítette: MesterWeb"},
    en: {mweb_eye:"NO WEBSITE YET?",mweb_title:"Would you like a modern website for your dog grooming salon?",mweb_text:"Mancs & Móka is a demo website. We create similar sites tailored to your own name, services, prices, images and contact details for dog groomers and other small businesses.",mweb_cta:"I’m interested in a website →",footer_text:"Beautiful coat, happy dog, relaxed owner.",page:"Page",contact:"Contact",free_gallery_title:"FREE IMAGE GALLERY",free_gallery_text:"Sample images included with the template and easy to replace.",sources:"View image credits and photographers →",madeby:"Website by: MesterWeb"},
    es: {mweb_eye:"¿TODAVÍA NO TIENES WEB?",mweb_title:"¿Quieres una web moderna para tu peluquería canina?",mweb_text:"Mancs & Móka es una web de demostración. Creamos páginas similares adaptadas con tu nombre, servicios, precios, imágenes y datos de contacto para peluquerías caninas y otros pequeños negocios.",mweb_cta:"Me interesa una página web →",footer_text:"Pelaje bonito, perro feliz, dueño tranquilo.",page:"Página",contact:"Contacto",free_gallery_title:"GALERÍA DE IMÁGENES GRATIS",free_gallery_text:"Imágenes de muestra incluidas con la plantilla y fáciles de sustituir.",sources:"Ver fuentes de imágenes y fotógrafos →",madeby:"Web creada por: MesterWeb"}
  };

  window.setLanguage = function (next) {
    if (!supported.includes(next)) return;
    safeStorage.set("wl-language", next);
    if (next !== window.WHITE_LABEL_LANGUAGE) {
      window.location.reload();
    }
  };

  window.applyWhiteLabelTranslations = function () {
    const dict = Object.assign({}, footerFallback[lang] || footerFallback.hu, window.LNKR_LANG || {});
    document.documentElement.lang = lang;

    document.querySelectorAll("[data-i18n]").forEach(el => {
      const key = el.dataset.i18n;
      if (dict[key] !== undefined) el.textContent = dict[key];
    });

    document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
      const key = el.dataset.i18nPlaceholder;
      if (dict[key] !== undefined) el.placeholder = dict[key];
    });

    document.querySelectorAll("[data-i18n-aria]").forEach(el => {
      const key = el.dataset.i18nAria;
      if (dict[key] !== undefined) el.setAttribute("aria-label", dict[key]);
    });

    document.querySelectorAll("[data-lang]").forEach(el => {
      el.classList.toggle("active", el.dataset.lang === lang);
      el.setAttribute("aria-pressed", el.dataset.lang === lang ? "true" : "false");
    });

    window.dispatchEvent(new CustomEvent("wl-language-ready", { detail: { lang } }));
  };

  const whenDomReady = (fn) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", fn, { once: true });
    } else {
      fn();
    }
  };

  // Keep language buttons functional even if inline handlers are blocked by hosting/CSP.
  whenDomReady(() => {
    document.querySelectorAll("[data-lang]").forEach(button => {
      button.addEventListener("click", () => window.setLanguage(button.dataset.lang));
    });
  });

  const script = document.createElement("script");
  script.src = `lang/${lang}.js`;
  script.onload = () => whenDomReady(window.applyWhiteLabelTranslations);
  script.onerror = () => {
    console.error(`Language file could not be loaded: lang/${lang}.js`);
    whenDomReady(window.applyWhiteLabelTranslations);
  };
  document.head.appendChild(script);
})();
